# Every text file is stored and checked out with LF line endings. The generated files are compared byte by byte with
# what `labtrack-bi build` writes, and the checksums of data/ are computed on LF: without these lines, Git on Windows
# may turn them into CRLF and `labtrack-bi check` and the data tests would fail.
* text=auto
*.csv       text eol=lf
*.pq        text eol=lf
*.dax       text eol=lf
*.tmdl      text eol=lf
*.json      text eol=lf
*.pbip      text eol=lf
*.pbir      text eol=lf
*.pbism     text eol=lf
.platform   text eol=lf
*.svg       text eol=lf
*.md        text eol=lf
*.py        text eol=lf
*.cjs       text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.png       binary
SHA256SUMS  text eol=lf
LICENSE     text eol=lf
NOTICE      text eol=lf
