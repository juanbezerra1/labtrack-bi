/// One row per recording (bi.fact_recording). The date comes through Session; the trial counts are counted from the Trial table, so date_key, n_trials and n_valid_trials are not imported.
table Recording
	lineageTag: 7394e7de-2509-5e64-9cd2-6d85c37f292d

	column 'Recording Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 164d8506-4d4b-5a11-a03d-b5eb5fece432
		summarizeBy: none
		sourceColumn: Recording Key

		annotation SummarizationSetBy = Automatic

	column 'Session Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 84e8bcea-91fb-56ec-9f36-b2f4f334cd38
		summarizeBy: none
		sourceColumn: Session Key

		annotation SummarizationSetBy = Automatic

	column 'Device Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 67d55057-d2d9-568b-8960-ef84a45926bf
		summarizeBy: none
		sourceColumn: Device Key

		annotation SummarizationSetBy = Automatic

	column Modality
		dataType: string
		lineageTag: 0c7d4030-cea0-545b-8ed7-b574b7705aa4
		summarizeBy: none
		sourceColumn: Modality

		annotation SummarizationSetBy = Automatic

	column 'Sampling Rate Hz'
		dataType: int64
		formatString: #,0
		lineageTag: 05400f9d-732a-5163-8fac-bcb1b63e4b9d
		summarizeBy: none
		sourceColumn: Sampling Rate Hz

		annotation SummarizationSetBy = Automatic

	column Channels
		dataType: int64
		formatString: 0
		lineageTag: d556fa49-8e01-5f0a-8071-cb1073a9355d
		summarizeBy: none
		sourceColumn: Channels

		annotation SummarizationSetBy = Automatic

	column 'Duration Seconds'
		dataType: double
		formatString: #,0.0
		lineageTag: 10dc5bdf-99b1-5735-ba03-ddc34d9fef4a
		summarizeBy: none
		sourceColumn: Duration Seconds

		annotation SummarizationSetBy = Automatic

	column 'Size MB'
		dataType: double
		formatString: #,0.00
		lineageTag: 25f93434-731d-51bd-9f05-22748cd7b1ef
		summarizeBy: none
		sourceColumn: Size MB

